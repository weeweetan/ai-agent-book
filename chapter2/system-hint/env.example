# Shared chat API selection (install the root package: pip install -e .).
# Choose ONE provider; do not keep an old Kimi model override when switching.
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# Or: LLM_PROVIDER=openai, OPENAI_API_KEY=your-openai-key, LLM_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# See docs/provider-compatibility.md at the repository root.
# Speech, image generation and embeddings keep their separate credentials.

# API Configuration
KIMI_API_KEY=your-kimi-api-key-here
# Alibaba Cloud Model Studio / Bailian (Qwen)
# LLM_PROVIDER=dashscope  # qwen and bailian are accepted aliases
# DASHSCOPE_API_KEY=your-dashscope-api-key-here
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 通用回退：未设置 KIMI_API_KEY 时，若配置了 OPENROUTER_API_KEY，则自动改走
# OpenRouter（kimi-* 会映射为 moonshotai/kimi-k2）。
# OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: LLM Provider Settings
# Legacy/default provider; use LLM_PROVIDER above to switch:
# LLM_PROVIDER=kimi
# Optional explicit model override (otherwise chosen for LLM_PROVIDER):
# LLM_MODEL=kimi-k3

# System Hint Features (all default to true)
ENABLE_TIMESTAMPS=true
ENABLE_TOOL_COUNTER=true
ENABLE_TODO_LIST=true
ENABLE_DETAILED_ERRORS=true
ENABLE_SYSTEM_STATE=true

# Formatting Options
TIMESTAMP_FORMAT=%Y-%m-%d %H:%M:%S
SIMULATE_TIME_DELAY=false

# Execution Options
MAX_ITERATIONS=20
VERBOSE=false
COMMAND_TIMEOUT=30
