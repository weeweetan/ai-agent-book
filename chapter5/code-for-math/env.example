# Shared chat API selection (install the root package: pip install -e .).
# Choose ONE provider; do not keep an old Kimi model override when switching.
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# Or: LLM_PROVIDER=openai, OPENAI_API_KEY=your-openai-key, LLM_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# See docs/provider-compatibility.md at the repository root.
# Speech, image generation and embeddings keep their separate credentials.

# 至少配置一个 key（优先使用 OPENAI_API_KEY）
OPENAI_API_KEY=your_openai_api_key_here
# MOONSHOT_API_KEY=your_moonshot_api_key_here   # 可选，Kimi（kimi-k3）
# ARK_API_KEY=your_ark_api_key_here             # 可选，豆包

# 通用兜底：未配置任何直连 key 时自动改走 OpenRouter；
# 另外默认模型 gpt-5.6-luna（gpt-5.x）在设置了本 key 时会优先走 OpenRouter，
# 因为直连 OpenAI 调用 gpt-5.6 需要组织实名认证。
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# 可选：切换到兼容 OpenAI 协议的服务端点
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：指定模型（默认 gpt-5.6-luna）
# MODEL=gpt-5.6-luna
