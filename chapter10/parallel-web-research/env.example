# Shared chat API selection (install the root package: pip install -e .).
# Choose ONE provider; do not keep an old Kimi model override when switching.
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# Or: LLM_PROVIDER=openai, OPENAI_API_KEY=your-openai-key, LLM_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# See docs/provider-compatibility.md at the repository root.
# Speech, image generation and embeddings keep their separate credentials.

# Set at least one real text-model provider. The first successful endpoint performs
# evidence-constrained profile extraction from text rendered by Chromium.
# ARK_API_KEY=
# ARK_MODEL=doubao-seed-1-6-250615
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=kimi-k3
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=
# OPENROUTER_API_KEY=
